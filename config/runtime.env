# Permanent single-Agent MXFP8 W8A8 profile. Override only after recorded runtime evidence.
MODEL_DIR=/data/linux-fast/models/Qwen3.6-40B-Eleanor-MXFP8-W8A8
SERVED_MODEL_NAME=qwen3.6-40b-eleanor
HOST=127.0.0.1
PORT=8000
TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.97
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=1
# Chunked prefill keeps a 64K request while bounding each prefill iteration.
MAX_NUM_BATCHED_TOKENS=2048
MAX_PARALLEL_LOADING_WORKERS=1
DTYPE=bfloat16
KV_CACHE_DTYPE=auto
LANGUAGE_MODEL_ONLY=true
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=qwen3_coder
ENABLE_MTP=false
