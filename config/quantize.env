# One-shot permanent MXFP8 W8A8 build profile. The output must not exist.
SOURCE_MODEL_DIR=/data/linux-fast/models/Qwen3.6-40B-Eleanor
FP8_MODEL_DIR=/data/linux-fast/models/Qwen3.6-40B-Eleanor-MXFP8-W8A8
FP8_STAGE_PREFIX=/data/linux-fast/models/.Qwen3.6-40B-Eleanor-MXFP8-W8A8.staging
FP8_SCHEME=MXFP8
MAX_WORKERS=2
CUDA_DEVICES=0,1
IGNORE_MODULES_JSON='["re:.*lm_head$","re:.*embed_tokens$","re:.*conv1d$","re:.*in_proj_a$","re:.*in_proj_b$","re:^mtp.*","re:.*visual.*","re:.*vision.*","re:.*norm.*"]'
